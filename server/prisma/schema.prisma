generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  nickname     String?
  avatarPath   String?
  createdAt    DateTime      @default(now())
  memberships  SpaceMember[]
  events       Event[]
  createdSpaces Space[]   @relation("CreatedSpaces")
}

model Space {
  id         String        @id @default(cuid())
  inviteCode String        @unique
  startDate  DateTime?
  createdBy  String
  createdAt  DateTime      @default(now())
  members    SpaceMember[]
  events     Event[]
  aiConfig   AiConfig?
  owner      User          @relation("CreatedSpaces", fields: [createdBy], references: [id])
}

model SpaceMember {
  id       String   @id @default(cuid())
  spaceId  String
  userId   String
  role     String   @default("owner") // owner | member
  joinedAt DateTime @default(now())
  space    Space    @relation(fields: [spaceId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([spaceId, userId])
}

model Event {
  id            String   @id @default(cuid())
  spaceId       String
  authorId      String
  happenedAt    DateTime
  lat           Float?
  lng           Float?
  locationName  String?
  note          String?
  content       String?
  isAiGenerated Boolean  @default(false)
  editedByUser  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  space         Space    @relation(fields: [spaceId], references: [id])
  author        User     @relation(fields: [authorId], references: [id])
  photos        Photo[]
}

model Photo {
  id        String   @id @default(cuid())
  eventId   String
  filePath  String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
}

model AiConfig {
  id        String   @id @default(cuid())
  spaceId   String   @unique
  baseUrl   String
  apiKey    String
  model     String
  style     String   @default("warm")
  updatedAt DateTime @updatedAt
  space     Space    @relation(fields: [spaceId], references: [id])
}
